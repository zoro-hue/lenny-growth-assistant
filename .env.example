# ==============================================================================
# The Lenny Growth Assistant - Environment Variables Template
# ==============================================================================
# Copy this file to .env (for local dev) or set these variables in Railway / Vercel.

# ------------------------------------------------------------------------------
# FRONTEND (Vercel Environment Variables)
# ------------------------------------------------------------------------------
# Set this in your Vercel Project Settings -> Environment Variables.
# Replace with your deployed Railway backend URL (no trailing slash):
VITE_API_URL=https://your-backend-production.up.railway.app

# ------------------------------------------------------------------------------
# BACKEND (Railway Service Environment Variables)
# ------------------------------------------------------------------------------
APP_ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Database Configuration:
# On Railway, attach a PostgreSQL service to your backend.
# Railway automatically injects DATABASE_URL into your environment.
# Both postgresql:// and postgresql+asyncpg:// connection strings are supported.
DATABASE_URL=postgresql://postgres:password@host:port/railway
DATABASE_SYNC_URL=postgresql://postgres:password@host:port/railway

# Optional SQLite fallback for offline local testing:
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./lenny_growth.db

# CORS Allowed Origins:
# Comma-separated list of origins. (Vercel *.vercel.app preview URLs are auto-allowed by regex)
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# ------------------------------------------------------------------------------
# Cloud LLM & Embedding (OpenAI Production)
# ------------------------------------------------------------------------------
# Required for production answers and embeddings:
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
CLOUD_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30.0

# Embedding Provider:
# Options: "openai" (recommended for production), "auto" (uses OpenAI if key set, else mock), "mock"
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ------------------------------------------------------------------------------
# Agent Framework Configuration
# ------------------------------------------------------------------------------
AGENT_FRAMEWORK=pi_coding_agent
ACTIVE_AGENT_FRAMEWORK=pi_coding_agent
AGENT_MAX_ITERATIONS=5
MODEL_FALLBACK_ENABLED=false

# ------------------------------------------------------------------------------
# Local Provider (Ollama - Local Demo Only)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=45.0

# ------------------------------------------------------------------------------
# RAG Retrieval Configuration
# ------------------------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=3
SIMILARITY_THRESHOLD=0.10
TRANSCRIPTS_DATA_DIR=data/transcripts
