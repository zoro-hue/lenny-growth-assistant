# The Lenny Growth Assistant - Environment Variables
# Copy this file to .env and configure your values.

# Application Environment
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Primary PostgreSQL + pgvector (recommended for production):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/lenny_growth

# Local SQLite Fallback Database (used automatically if PostgreSQL is unavailable):
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./lenny_growth.db

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Embedding Provider
# Options: "auto" (uses OpenAI if API key present, else mock), "openai", "ollama", "mock"
EMBEDDING_PROVIDER=mock

# Cloud Provider (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30.0

# Local Provider (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=45.0

# Fallback & Agent Framework
MODEL_FALLBACK_ENABLED=true
AGENT_FRAMEWORK=pi_coding_agent
ACTIVE_AGENT_FRAMEWORK=pi_coding_agent
AGENT_MAX_ITERATIONS=5

# RAG Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=3
SIMILARITY_THRESHOLD=0.10
