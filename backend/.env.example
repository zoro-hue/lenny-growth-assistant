# ==========================================
# The Lenny Growth Assistant - Backend Config
# ==========================================

# Application
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
# Primary PostgreSQL URL (with asyncpg driver):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth
# Sync database URL for Alembic migrations:
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/lenny_growth

# Fallback SQLite database path when PostgreSQL daemon is offline (optional)
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./lenny_growth.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# LLM & Agent Providers
# Provider mode: "auto" (uses OpenAI if key present, else mock) | "openai" | "ollama" | "mock"
EMBEDDING_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30.0

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=45.0

MODEL_FALLBACK_ENABLED=false
AGENT_FRAMEWORK=pi_coding_agent
AGENT_MAX_ITERATIONS=5

CLOUD_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# RAG & Chunking Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=3
SIMILARITY_THRESHOLD=0.10
TRANSCRIPTS_DATA_DIR=data/transcripts
