# ==============================================================================
# The Lenny Growth Assistant - Backend Production & Development Config
# ==============================================================================

# Application Environment
APP_ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Database Configuration
# On Railway, attach PostgreSQL database to populate DATABASE_URL automatically.
# Both postgresql:// and postgresql+asyncpg:// are parsed and supported.
DATABASE_URL=postgresql://postgres:password@host:port/railway
DATABASE_SYNC_URL=postgresql://postgres:password@host:port/railway
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./lenny_growth.db

# CORS Allowed Origins
# Comma-separated domains. Note: https://*.vercel.app is allowed automatically via regex.
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Cloud Provider (OpenAI) - Production
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
CLOUD_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30.0

# Embedding Provider
# Set to "openai" for production pgvector embeddings, or "auto"
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Local Provider (Ollama - Local Demo Only)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=45.0

# Agent Framework
MODEL_FALLBACK_ENABLED=false
AGENT_FRAMEWORK=pi_coding_agent
ACTIVE_AGENT_FRAMEWORK=pi_coding_agent
AGENT_MAX_ITERATIONS=5

# RAG Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=3
SIMILARITY_THRESHOLD=0.10
TRANSCRIPTS_DATA_DIR=data/transcripts
